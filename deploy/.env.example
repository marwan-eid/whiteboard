# Copy to .env next to compose.yaml on the server. Never commit .env.
# The public domain; Caddy gets a certificate for it.
SITE_ADDRESS=example.duckdns.org
# Long random strings: openssl rand -hex 32
SECRET=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Image tag to run: latest, or a commit SHA from the release workflow.
IMAGE_TAG=latest
# Object Storage pre-authenticated request URL for uploads (ends with /o/);
# terraform output backup_upload_url. Empty keeps backups on the server only.
BACKUP_UPLOAD_URL=
# When the nightly backup runs (UTC, HH:MM).
BACKUP_AT=03:00
